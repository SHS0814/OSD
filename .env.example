# cp .env.example .env  (.env is gitignored; never commit real keys)
# Read by `docker compose --env-file .env -f infra/docker-compose.yml ...`.
# A local `uvicorn` run does not read this file (see README).

POSTGRES_DB=campus_shade
POSTGRES_USER=campus_shade
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://campus_shade:change-me@db:5432/campus_shade
# Host port for the API (bound to 127.0.0.1 only).
API_PORT=8000
CLOUDFLARE_TUNNEL_TOKEN=

# 기상청 API허브 key: live weather after the committed snapshot. Empty = snapshot only.
KMA_APIHUB_KEY=
# VWorld key and its registered domain: satellite tiles (server), scripts/build_tree_canopy.py,
# scripts/fetch_campus_parcels.py.
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost
# 공공데이터포털 key (Decoding), only for scripts/fetch_building_ledger.py and scripts/fetch_kma_asos.py.
DATA_GO_KR_API_KEY=

# The Android app's API address is a Gradle property, not read from here:
#   echo 'API_BASE_URL=http://10.0.2.2:8000/' >> ~/.gradle/gradle.properties
